# Copy to .env. Everything is optional.

# Gemini API key (https://aistudio.google.com/apikey). With it, recommendations take seconds.
# Without it they come from local Ollama (minutes on a CPU-only server), then simple rules.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Local Ollama fallback.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TIMEOUT_SECONDS=300

# Wikimedia requires a contact URL in the user agent.
USER_AGENT=weekend-planner/0.1 (https://github.com/vikramDlearners/October_backend)

APP_NAME=project
APP_VERSION=0.1.0
APP_ENV=development
