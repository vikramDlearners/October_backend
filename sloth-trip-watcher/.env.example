# Copy to .env and fill in what you have. Every integration is optional;
# GET /api/health shows which ones are live.

# Google AI Studio key (https://aistudio.google.com/apikey). Used to call Gemma.
# Without it, a simple rules fallback decides.
GEMINI_API_KEY=

# Gemini Flash prices GO plans (fares, entry fees, food) with Google Search
# grounding, using the same GEMINI_API_KEY. Over-budget plans become NOT_YET.
GEMINI_FLASH_MODEL=gemini-3.8-flash

# gemma-4-31b-it or gemma-4-26b-a4b-it (gemma-3-27b-it is gone and returns 404).
GEMMA_MODEL=gemma-4-31b-it

# SerpApi key (https://serpapi.com) for Google Maps places.
# Without it, Gemma plans from its own knowledge of the place.
SERPAPI_KEY=

# The FULL token from @BotFather, shaped <digits>:<~35 chars>. Use a different bot
# from any other program (e.g. Hermes): only one program can read a bot's updates.
TELEGRAM_BOT_TOKEN=

# Chat to alert. Numeric; negative for groups. Message your bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and read message.chat.id.
TELEGRAM_CHAT_ID=

# Email service for the Send tab. The server POSTs { to, subject, text, itinerary }
# here. Without it, POST /api/watches/:id/send returns 503.
ITINERARY_API_URL=

# Origin allowed to call the API from a browser when the page is hosted elsewhere.
# Use * for any origin, or e.g. https://sloth.example.com.
CORS_ORIGIN=*

# How often every watch is re-checked, in hours.
CHECK_EVERY_HOURS=12

# Listens on 0.0.0.0:PORT. Render sets PORT itself.
PORT=3000

# Where watches.json lives.
DATA_DIR=./data
